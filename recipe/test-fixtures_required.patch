From de04d603852682a73a70fc8107f62dd3db920c0e Mon Sep 17 00:00:00 2001
From: Duncan Macleod <macleoddm@cardiff.ac.uk>
Date: Fri, 26 Jun 2026 13:45:44 +0100
Subject: [PATCH] fix(framecpp): correct broken test fixture property

Closes https://git.ligo.org/computing/ldastools/LDAS_Tools/-/work_items/363
---
 framecpp/test/CMakeLists.txt | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/framecpp/test/CMakeLists.txt b/framecpp/test/CMakeLists.txt
index 7220b2fda..04c22b568 100644
--- a/framecpp/test/CMakeLists.txt
+++ b/framecpp/test/CMakeLists.txt
@@ -251,7 +251,7 @@ function( framecpp_target_test_downconvert version )
     )
     set_tests_properties( "test_downconvert_framecpp_sample_${version}"
       PROPERTIES
-      FIXTURES_REQUIRES "fixture_downconvert_framecpp_sample_${version}"
+      FIXTURES_REQUIRED "fixture_downconvert_framecpp_sample_${version}"
       ENVIRONMENT "${TESTS_ENVIRONMENT}"
     )
   endif( )
@@ -813,15 +813,15 @@ if(BUILD_TESTING)
   if(FR_CHECK)
     set_tests_properties(verify_smallest_frame_v6_via_fr_check
       PROPERTIES
-      FIXTURES_REQUIRES fixture_smallest_frames
+      FIXTURES_REQUIRED fixture_smallest_frames
     )
     set_tests_properties(verify_smallest_frame_v7_via_fr_check
       PROPERTIES
-      FIXTURES_REQUIRES fixture_smallest_frames
+      FIXTURES_REQUIRED fixture_smallest_frames
     )
     set_tests_properties(verify_smallest_frame_v8_via_fr_check
       PROPERTIES
-      FIXTURES_REQUIRES fixture_smallest_frames
+      FIXTURES_REQUIRED fixture_smallest_frames
     )
   endif()
 endif()
